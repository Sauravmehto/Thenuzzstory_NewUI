# Copy to .env.local (never committed) and fill in.

# Password for the local product admin at /admin. Leave empty to disable the admin.
ADMIN_PASSWORD=

# Optional: a separate random secret for signing admin sessions
# (defaults to one derived from ADMIN_PASSWORD). e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
ADMIN_SESSION_SECRET=

# The admin saves to data/catalog.json on this machine, so it is OFF in production
# builds (hosted file systems are read-only/ephemeral). Set to 1 only to try the
# admin under `npm run start` locally.
ADMIN_ENABLE_IN_PRODUCTION=

# ── Customer accounts (sign in / create account) ─────────────────────────────
# REQUIRED in production: a long random secret that signs login sessions.
# Set it in Netlify → Site configuration → Environment variables. Without it,
# sign-in shows "not available" (shopping and guest checkout still work).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs everyone out. Locally it's optional (a dev secret is kept in .data/).
AUTH_SECRET=

# Optional: where accounts are stored. Auto-detected: Netlify Blobs on Netlify,
# local files in .data/accounts (git-ignored) everywhere else. Values: blobs | file
ACCOUNT_STORE=

# Optional: folder for local data (accounts, orders). Default: ./.data (git-ignored).
# Orders need no other env: they use Netlify Blobs on Netlify and files locally.
DATA_DIR=
