# dependencies and build output (regenerated by npm install / npm run build)
node_modules/
.next/
.next-dev/
out/
*.tsbuildinfo

# test output
test-results/
playwright-report/
coverage/

# local secrets (e.g. ADMIN_PASSWORD)
# local customer accounts + dev auth secret (never commit)
.data/
.data-e2e/
.env*
!.env.example

# OS / editor
.DS_Store
Thumbs.db

# separate production build used by the e2e tests (npm run build:e2e)
.next-e2e/
# catalog write lock (transient)
data/.catalog.lock
